        "Referer": "https://site.example.com",
        "Cookie": "site_cookie=1",
        "X-Ignored": "evil"
      },
      "ext": {
        "ua": "ExtUA/2.0",
        "headers": {
          "Cookie": "ext_cookie=2"
        }
      }
    }
  ]
}