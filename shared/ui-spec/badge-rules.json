{
  "schemaVersion": 1,
  "project": "Marco Movie",
  "license": "GPL-3.0-only",
  "caseInsensitive": true,
  "textOnlyBadges": true,
  "evaluationContract": {
    "normalization": [
      "1. If input is null, treat as empty string and return [].",
      "2. Percent-decode valid %XX UTF-8 byte sequences ONLY (never convert literal '+' into space, so 'HDR10+' and 'DD+' stay intact; leave malformed '%' untouched; replace invalid UTF-8 bytes with U+FFFD).",
      "3. Replace ASCII control characters [\\u0000-\\u001F\\u007F]+ (including \\r and \\n) with a single space ' ', trim leading/trailing ASCII whitespace, and truncate to at most 1024 UTF-16 code units.",
      "4. If normalized string is empty, return []."
    ],
    "matchingAndComboPass": [
      "1. Precompile every rule.pattern with Pattern.compile(pattern, Pattern.CASE_INSENSITIVE) in Java and RegExp(pattern, caseSensitive: false) in Dart.",
      "2. Evaluate all base rules against the normalized string; record matched rule IDs in set M.",
      "3. Iterate comboRules in ascending priority order: a comboRule triggers iff ALL rule IDs in comboRule.requires are currently present in M. When triggered, remove all rule IDs in comboRule.consumes from M and emit the comboRule badge.",
      "4. Collect all remaining unconsumed base rules in M plus all triggered comboRules, and sort deterministically by (priority ASC, id ASC)."
    ],
    "regexSubsetGuarantee": "Patterns use ONLY anchors (^, $), '.', '*', '+', '?', '{m,n}', character classes '[...]', non-capturing groups '(?:...)', alternation '|', positive lookahead '(?=...)', and negative lookahead '(?!...)'. Zero inline flags '(?i)', zero lookbehinds '(?<=...)'/'(?<!...)', zero atomic groups '(?>...)', zero possessive quantifiers, zero '\\K', and zero '\\b'/'\\B' (explicit ASCII boundaries '[^a-z0-9]' ensure identical CJK/underscore behavior across Android API 14 ICU, JDK 17, and Dart 3.10.8 ECMA-262)."
  },
  "groups": [
    {
      "id": "resolution",
      "title": "分辨率",
      "order": 1,
      "exclusivityNote": "Strictly mutually exclusive via lookaheads: explicit downscale tags (1080p/720p/SD) override upstream master tags (e.g. '4K.Remastered.1080p' -> '1080p'), and 1080p > 720p > SD."
    },
    {
      "id": "dynamic_range",
      "title": "动态范围与杜比组合",
      "order": 2,
      "exclusivityNote": "Cascading HDR10+ > HDR10 > HLG/HDR lookaheads; HDR10 excludes standalone '10bit'/'Hi10p' without HDR; DV combines with ATMOS/TrueHD/DD+ via comboRules while allowing base-layer HDR10/HDR10+ to co-display."
    },
    {
      "id": "source_quality",
      "title": "片源介质",
      "order": 3,
      "exclusivityNote": "REMUX suppresses BluRay via negative lookahead; WEB-DL suppresses WEBRip."
    },
    {
      "id": "audio_codec",
      "title": "音频编码",
      "order": 4,
      "exclusivityNote": "Cascading DTS:X > DTS-HD MA > DTS-HD > DTS and DD+ > DD mutual exclusion via negative lookaheads."
    },
    {
      "id": "audio_channels",
      "title": "声道布局",
      "order": 5,
      "exclusivityNote": "Highest surround layout wins (7.1 > 5.1 > 2.0) via negative lookaheads; rejects file sizes (e.g. 5.1GB, 2.0 GB) and version tags (e.g. v2.0, v1.5.1)."
    },
    {
      "id": "video_codec",
      "title": "视频编码",
      "order": 6,
      "exclusivityNote": "Matches scene tags (x265/H.265, x264/H.264, AV1, VP9) and player track codec fourccs (hvc1/hev1, avc1, av01, vp09)."
    },
    {
      "id": "release_platform",
      "title": "发行平台缩写",
      "order": 7,
      "exclusivityNote": "Strictly text-only neutral abbreviations (NF, AMZN, ATVP, DSNP, MAX, HULU, PCOK, PMTP, BILI, CR); zero logos."
    }
  ],
  "rules": [
    {
      "id": "res_8k",
