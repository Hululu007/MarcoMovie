<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <size android:width="96dp" android:height="96dp" />
      <corners android:radius="22dp" />
      <gradient
          android:angle="315"
          android:startColor="#1E2233"
          android:endColor="#10121B" />
      <stroke android:width="2dp" android:color="#3A425E" />
    </shape>
  </item>
  <item
      android:left="14dp"
      android:top="20dp"
      android:right="14dp"
      android:bottom="20dp">
    <shape android:shape="rectangle">
      <corners android:radius="12dp" />
      <solid android:color="#151926" />
      <stroke android:width="2dp" android:color="#0A84FF" />
    </shape>
  </item>
  <item
      android:left="30dp"
      android:top="30dp"
      android:right="30dp"
      android:bottom="30dp">
    <shape android:shape="oval">
      <solid android:color="#0A84FF" />
    </shape>
  </item>
  <item
      android:left="41dp"
      android:top="41dp"
      android:right="41dp"
      android:bottom="41dp">
    <rotate
        android:fromDegrees="45"
        android:pivotX="50%"
        android:pivotY="50%">
      <shape android:shape="rectangle">
        <corners android:radius="2dp" />
        <solid android:color="#FFFFFF" />
      </shape>
    </rotate>
  </item>
</layer-list>
